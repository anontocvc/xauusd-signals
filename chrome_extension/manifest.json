{
  "manifest_version": 3,
  "name": "XAUUSD Pro Signals",
  "version": "1.1.0",
  "description": "Real-time XAUUSD SMC/ICT signal overlay. Connects to your local signal server.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://localhost:5000 http://127.0.0.1:5000"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "XAUUSD Signals"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
